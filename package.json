{
  "name": "eisy-myanmar-card",
  "version": "1.0.0",
  "private": true,
  "description": "Eisy Myanmar card platform \u2014 Vercel entry + utilities",
  "main": "api/index.js",
  "scripts": {
    "create-wallet": "node create-wallet.js",
    "start": "npm start --prefix backend",
    "dev": "npm run dev --prefix backend",
    "migrate": "npm run migrate --prefix backend",
    "test:portal-routes": "node backend/scripts/test-portal-routes.js",
    "test:admin-pipelines": "node backend/scripts/test-admin-pipelines.js",
    "test:admin-kripicard-balance": "node backend/scripts/test-admin-kripicard-balance.js",
    "test:kripicard-payment-collections": "node backend/scripts/test-kripicard-payment-collections.js",
    "test:kripicard-deposits": "node backend/scripts/test-kripicard-deposits.js",
    "test:kripicard-deposit-ui": "node backend/scripts/test-kripicard-deposit-ui.js",
    "test:kripicard-withdraw-fee": "node backend/scripts/test-kripicard-withdraw-fee.js",
    "test:sidebar-nav-cleanup": "node backend/scripts/test-sidebar-nav-cleanup.js",
    "write-portal-html": "node backend/scripts/write-portal-html.js && node backend/scripts/write-admin-portal-html.js",
    "test:dashboard-usdt-wallet": "node backend/scripts/test-dashboard-usdt-wallet-only.js",
    "test:usdt-wallet-perf": "node backend/scripts/test-usdt-wallet-perf.js",
    "test:deposits-usdt-only": "node backend/scripts/test-deposits-usdt-only.js",
    "test:admin-usdt-mmk-wd": "node backend/scripts/test-admin-usdt-mmk-withdrawals.js",
    "test:legal-pages": "node backend/scripts/test-legal-pages.js",
    "vercel-build": "node backend/scripts/write-public-supabase-config.js; node backend/scripts/write-portal-html.js; node backend/scripts/write-admin-portal-html.js; node backend/scripts/test-tron-wallet-init.js || echo \"[vercel-build] TRON wallet init check failed (non-blocking \u2014 see /health/tron after deploy)\"; mkdir -p public && cp -R backend/public/. public/",
    "android:apk": "bash scripts/build-android-apk.sh debug",
    "android:apk:release": "bash scripts/build-android-apk.sh release"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyaephyonaingpol-bot/eisy-myanmar-card.git"
  },
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@libsql/linux-x64-gnu": "^0.5.29",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^0.66.0",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "stripe": "^22.6.1",
    "tronweb": "^6.4.0"
  }
}

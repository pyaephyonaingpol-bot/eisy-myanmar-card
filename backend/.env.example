# =============================================================================
# Eisy Myanmar — Environment Variable Template
# Copy to backend/.env (or project root .env.local) and fill in real values.
# Never commit real secrets. See backend/docs/SECURE_SECRETS.md for Vercel/Cursor/GitHub workflow.
# =============================================================================

NODE_ENV=production
PORT=3000

# Public site URL (used to build Binance webhook/return URLs when not overridden)
PUBLIC_BASE_URL=https://eisymyanmar.com

# ---- Auth / Admin ----
AUTH_SECRET=change-this-to-a-long-random-string
ADMIN_API_KEY=  # openssl rand -hex 32 — required to bootstrap first Super Admin
# Operator login — set BOTH on Vercel production so serverless cold starts
# sync this email/password into Turso as super_admin (see ensureEnvSuperAdmin).
# Without these, /admin login can fail with "Invalid email or password" after
# password drift. Heal anytime: ADMIN_API_KEY=... npm run ensure-env-admin -- --remote https://eisymyanmar.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Field-level encryption for passport / NRC / KYC PII at rest (AES-256-GCM).
# REQUIRED in production — without this key, KYC writes fail closed.
# Generate: openssl rand -hex 32
SENSITIVE_DATA_ENCRYPTION_KEY=
# Alias also accepted: FIELD_ENCRYPTION_KEY=

# ---- Stripe (optional card rails; webhook always verifies signature) ----
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Webhooks → Signing secret
# Register endpoint: https://YOUR_DOMAIN/api/webhook/stripe
# Fake / unsigned requests are rejected with 401.

# ---- HTTP security (Helmet + express-rate-limit; defaults are safe) ----
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_KYC_WINDOW_MS=3600000
# RATE_LIMIT_KYC_MAX=20

# Incident kill switches (safe defaults after Tron wallet compromise)
# WITHDRAWALS_PAUSED=true
# AUTO_ONCHAIN_WITHDRAWALS=false
# MASTER_WALLET_TRANSFERS_PAUSED=true
# PIN_TOKEN_TTL_HOURS=0.25
DEV_SHOW_OTP=false
OTP_EXPIRY_MINUTES=10
SESSION_EXPIRY_DAYS=30
PIN_TOKEN_TTL_HOURS=168

# ---- Database ----
# Local (default): LibSQL file at backend/data/eisy.db — no native sqlite3 needed
# Turso / LibSQL production (required on Vercel for persistence):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
# Legacy local only (optional deps): SQLITE_DRIVER=sqlite3

# ---- Pricing / FX ----
MMK_TO_USD_RATE=4500
# Payment service fee (deposit + withdrawal): Math.max(amount * pct/100, minimum)
# Defaults are 2% with $1 minimum when unset.
# PAYMENT_SERVICE_FEE_PERCENT=2
# PAYMENT_SERVICE_FEE_MINIMUM_USDT=1

# ---- Email OTP (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Eisy Myanmar <no-reply@eisymyanmar.com>

# ---- Telegram admin alerts + support live-chat bridge ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Optional forum topic for support tickets inside a Telegram group
# TELEGRAM_SUPPORT_TOPIC_ID=
# Shared secret for Telegram webhook header X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_WEBHOOK_SECRET=
# Webhook URL to set via BotFather / setWebhook:
#   https://YOUR_DOMAIN/api/webhook/telegram

# ---- Supabase (optional cloud sync) ----
# Server dual-write works with URL + SUPABASE_SERVICE_ROLE_KEY (anon key is for the browser).
# IMPORTANT: paste BARE values only — do NOT paste "KEY = value" assignment lines into secret slots.
# Browser bridge reads URL + anon key via GET /api/config/supabase (createClient in public SPA).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Persistent uploads (deposit receipts, P2P proofs, KYC) — run supabase/upload_storage.sql
# SUPABASE_UPLOAD_BUCKET=uploads
# SUPABASE_UPLOAD_STORAGE=true
# Aliases also accepted: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY

# ---- Bitnob Virtual Cards (create / fund / details) — KYC users ----
# Docs: https://bitnob.dev/docs/card-issuing/virtual-card-api-endpoint-reference
# Auth is HMAC (CLIENT_ID + CLIENT_SECRET). Same base URL for sandbox & production —
# the secret key selects the environment.
# BITNOB_CLIENT_ID=
# BITNOB_CLIENT_SECRET=
# BITNOB_API_BASE_URL=https://api.bitnob.com
# BITNOB_TIMEOUT_MS=30000
# BITNOB_MIN_AMOUNT_USD=1
# Optional fixed-IP reverse proxy on a VPS (see backend/docs/BITNOB_EGRESS_PROXY.md):
# BITNOB_EGRESS_PROXY_URL=https://bitnob-egress.yourdomain.com
# BITNOB_EGRESS_PROXY_SECRET=
# Bitnob provider fees passed through to the user USDT wallet (defaults match FAQ):
# BITNOB_CARD_CREATE_FEE_USD=2
# BITNOB_FUND_FEE_FLAT_USD=1
# BITNOB_FUND_FEE_PERCENT=1
# BITNOB_FUND_FEE_THRESHOLD_USD=100
# Optional shared sandbox / company Card KYC customer when users lack bitnob_customer_id:
# BITNOB_DEFAULT_CUSTOMER_ID=
# Chain for Standard Card deposit addresses (Bitnob Addresses API):
# BITNOB_DEPOSIT_CHAIN=tron
# Optional webhook for card lifecycle / funding events (singular /api/webhook):
# BITNOB_CARD_WEBHOOK_URL=https://eisymyanmar.com/api/webhook/bitnob/cards
# Standard Card deposit credits (Bitnob address → balance_bitnob_usdt, never Master Wallet):
# BITNOB_DEPOSIT_WEBHOOK_URL=https://eisymyanmar.com/api/webhook/bitnob/deposits
# Secret used to verify x-bitnob-signature (HMAC-SHA512 of raw body). Falls back to BITNOB_CLIENT_SECRET if unset:
# BITNOB_WEBHOOK_SECRET=

# ---- Dual wallet architecture ----
# Instant Card (No KYC)  → Master Wallet / TRON HD → users.balance_usdt → Kripicard
# Standard Card (KYC)    → Bitnob deposit address → users.balance_bitnob_usdt → Bitnob cards
# GET  /api/user/wallets/card-funding
# GET  /api/user/wallets/standard/deposit-address
# POST /api/user/card/request-instant   (alias of request-kripicard)
# POST /api/user/card/request-standard  (alias of card/request)

# ---- Kripicard Instant Cards (Non-KYC) — Master Wallet deposits ----
# KRIPICARD_API_KEY=
# KRIPICARD_CREATE_CARD_URL=https://appapi.kripicard.com/api/external/cards/createcard
# KRIPICARD_BINS_URL=https://appapi.kripicard.com/api/external/cards/bins
# KRIPICARD_DEFAULT_BIN=441357
# KRIPICARD_ALLOWED_BINS=
# KRIPICARD_TIMEOUT_MS=30000
# KRIPICARD_BINS_CACHE_MS=60000
# Service: backend/src/services/bitnobService.js + bitnobCardWebhookService.js
#   createVirtualCard / fundCard / getCardDetails
#   createVirtualCardFromUsdt / fundVirtualCardFromUsdt (legacy Master-Wallet debit path)
#   POST /api/webhook/bitnob/cards — async create/fund outcomes
#   POST /api/webhook/bitnob/deposits — Standard Card ledger credits
#   POST /api/user/cards/:id/sync — poll Bitnob and merge local card state
# Kripicard (Non-KYC / Instant):
#   POST /api/user/card/request-kripicard | /card/request-instant
#   GET  /api/user/card/bins
#   GET  /api/user/card/pricing-kripicard
# Real-time issue after payment:
#   Next.js: POST /api/cards/issue
#   Express:  POST /api/user/cards/issue  (Bitnob / Standard, KYC required)
#   Apply UI: Instant → Master Wallet + Kripicard; Standard → Bitnob wallet + Bitnob
# Admin card lookup (on-demand; pool sync retired):
#   Next.js: POST /api/admin/fetch-cards  { card_id }
#   Express:  POST /api/admin/fetch-cards { card_id }

# ---- USDT on-chain verification ----
BSCSCAN_API_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org/
TRONSCAN_API_URL=https://apilist.tronscan.org
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# Minimum confirmations before auto-approve (default 1)
# USDT_MIN_CONFIRMATIONS=1
# Reject rapid duplicate USDT deposit creates (same amount) / TxID submits (seconds). Default 90. Set 0 to disable.
# USDT_DEPOSIT_DUPLICATE_WINDOW_SEC=90
# NEVER enable in production — refuses to activate when NODE_ENV=production
# BYPASS_USDT_TX_VERIFICATION=false

# Shared secret for Android MMK deposit listener → POST /api/deposit/verify
# Required for the listener hook. Admins may call the same endpoint with X-Admin-Key.
# Required in production for listener clients (openssl rand -hex 32)
# DEPOSIT_LISTENER_SECRET=

# ---- TRON master wallet (USDT TRC20 deposits + withdrawals) ----
# Hex private key only — never commit real values. Prefer root /.env (gitignored).
# MASTER_PRIVATE_KEY=
# Optional explicit deposit address (defaults to address derived from the private key):
# MASTER_WALLET_ADDRESS=
# Alias also accepted: TRON_MASTER_WALLET=

# Optional Trongrid API key / full node override:
# TRONGRID_API_KEY=
# Alias also accepted: TRON_API_KEY=

# TRON_FULL_HOST=https://api.trongrid.io
# TRON_USDT_FEE_LIMIT_SUN=100000000
#
# Manual energy mode: pre-delegate energy (or keep TRX) on the master wallet.
# External Feee.io / ENERGY_RENTAL_* APIs are not used.
# Fixed fee for POST /api/withdraw (Net = withdrawAmount - fee):
# WITHDRAW_FIXED_FEE_USDT=2
#
# ---- Per-user TRON HD deposit addresses (BIP44 m/44'/195'/0'/0/{userId}) ----
# Prefer a dedicated deposit mnemonic (do NOT reuse the withdrawal hot-wallet key as mnemonic).
# TRON_HD_ENABLED=true
# TRON_HD_MNEMONIC="twelve or twenty four word bip39 mnemonic …"
# Or hex seed (≥16 bytes):
# TRON_HD_SEED_HEX=
# Optional: TRON_HD_ACCOUNT=0  TRON_HD_CHANGE=0  TRON_HD_INDEX_OFFSET=0
# If mnemonic/seed unset, MASTER_PRIVATE_KEY hex is used as BIP32 seed material (fallback).
# Apply Supabase SQL: supabase/user_tron_hd_addresses.sql
#
# Sweep HD deposits → master (MANUAL only — POST /api/admin/sweep-deposits or CLI).
# Not scheduled via cron. TRX gas is sent from master first, then USDT is swept back.
#   npm run sweep:tron-deposits -- --dry-run --all
# TRON_SWEEP_GAS_TRX=1.1
# TRON_SWEEP_GAS_WAIT_MS=3000
# Only sweep deposit addresses with at least this much USDT (default 25).
# TRON_SWEEP_MIN_USDT=25
# TRON_SWEEP_SKIP_GAS_IF_TRX=0.55
#
# ---- Custom TRON USDT gateway (Supabase orders + TronGrid poll) ----
# Shared gateway is the fallback when HD is disabled:
# MASTER_WALLET_ADDRESS=
# TRON_GATEWAY_DEPOSIT_ADDRESS=
# TRON_ORDER_POLL_MS=30000
# TRON_ORDER_POLL_ENABLED=true
# Cron/manual verify: POST /api/tron/orders/check/pending with DEPOSIT_LISTENER_SECRET header

# =============================================================================
# Binance Pay (works on Vercel Serverless + local/PM2)
# Set these in Vercel → Project Settings → Environment Variables
# Webhook URL to register in Binance: https://YOUR_DOMAIN/api/webhook/binance
# =============================================================================
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MERCHANT_ID=

# Aliases (also supported):
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_API_SECRET=
# BINANCE_PAY_MERCHANT_ID=

BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# Optional — auto-derived from PUBLIC_BASE_URL or VERCEL_URL when unset:
# BINANCE_PAY_WEBHOOK_URL=https://eisymyanmar.com/api/webhook/binance
# BINANCE_PAY_RETURN_URL=https://eisymyanmar.com/#deposits
# BINANCE_PAY_CANCEL_URL=https://eisymyanmar.com/#deposits

# Dev/test only — never enable in production:
# BINANCE_PAY_WEBHOOK_SKIP_VERIFY=true
# BINANCE_PAY_WEBHOOK_HMAC_FALLBACK=true
# BINANCE_PAY_QUERY_BEFORE_CREDIT=true

# =============================================================================
# Optional PM2
# =============================================================================
# Optional PM2 SSH deploy (GitHub Actions) — Vercel is the primary deploy path
# =============================================================================
# SSH_HOST=your.server.ip
# SSH_USER=deploy
# SSH_PRIVATE_KEY=<<pem private key>>
# DEPLOY_PATH=/var/www/eisy-myanmar-card
# PM2_APP_NAME=eisy-backend

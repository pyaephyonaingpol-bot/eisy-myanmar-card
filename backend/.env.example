# Supabase (optional — enables cloud sync + admin realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=development
MMK_TO_USD_RATE=4500
AUTH_SECRET=change-this-to-a-long-random-string
DEV_SHOW_OTP=true
OTP_EXPIRY_MINUTES=10
SESSION_EXPIRY_DAYS=30
PIN_TOKEN_TTL_HOURS=168

# Database (required on Vercel production — /tmp SQLite is ephemeral without this)
# Local default: backend/data/eisy.db (no DATABASE_URL needed)
# Turso example:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
# Or explicit local file:
# DATABASE_URL=file:./data/eisy.db

# Email OTP (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Eisy Myanmar <no-reply@eisymyanmar.com>

ADMIN_API_KEY=optional-admin-key-for-testing
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# USDT on-chain auto-verification (optional)

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install --omit=optional",
  "buildCommand": "mkdir -p .vercel-public-tmp && cp -R public/. .vercel-public-tmp/ && rm -rf .vercel-public-tmp",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    {
      "source": "/((?!assets/)(?!.*\\.).*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/api/webhook/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{migrations/**,public/**,src/**,api/**}",
      "excludeFiles": "{**/node_modules/sqlite3/**,**/node_modules/sqlite/**}"
    }
  }
}

# Root env template for Vercel + local.
# In Vercel Dashboard → Project → Settings → Environment Variables, add the keys below.
# See also: backend/.env.example

NODE_ENV=production
PUBLIC_BASE_URL=https://eisymyanmar.com

# Admin dashboard bootstrap / emergency API key (required for first Super Admin)
# Generate: openssl rand -hex 32
# ADMIN_API_KEY=

# Persistent DB — Turso / LibSQL (required on Vercel production)
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# Local default uses LibSQL file:backend/data/eisy.db (no native sqlite3).
# Legacy local only: SQLITE_DRIVER=sqlite3 (requires optional backend deps)
# SQLITE_DRIVER=libsql

# ---- Binance Pay (Vercel secrets) ----
# Certificate SN / API identity key:
BINANCE_API_KEY=
# HMAC secret:
BINANCE_SECRET_KEY=
# Merchant id (optional metadata / logging):
BINANCE_MERCHANT_ID=

# Aliases also accepted by the code:
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_API_SECRET=
# BINANCE_PAY_MERCHANT_ID=

# Optional overrides (auto-built from PUBLIC_BASE_URL or VERCEL_URL when unset)
# BINANCE_PAY_WEBHOOK_URL=https://eisymyanmar.com/api/webhook/binance
# BINANCE_PAY_RETURN_URL=https://eisymyanmar.com/#deposits
# BINANCE_PAY_CANCEL_URL=https://eisymyanmar.com/#deposits

# Fee: Math.max(amount * 0.02, 1) — defaults applied in code
# PAYMENT_SERVICE_FEE_PERCENT=2
# PAYMENT_SERVICE_FEE_MINIMUM_USDT=1

# TRON hot/master wallet private key (hex, no 0x). Never commit real values.
# Used by backend USDT TRC20 withdrawal completion (admin approve).
# Optional explicit deposit address (defaults to address derived from MASTER_PRIVATE_KEY):
# MASTER_WALLET_ADDRESS=
# MASTER_PRIVATE_KEY=
# TRONGRID_API_KEY=
# TRON_FULL_HOST=https://api.trongrid.io
#
# Per-user TRC20 HD deposit addresses (BIP44 m/44'/195'/0'/0/{userId}):
# TRON_HD_ENABLED=true
# TRON_HD_MNEMONIC="twelve word bip39 mnemonic …"
# Apply Supabase: supabase/user_tron_hd_addresses.sql

# ---- Kripicard Pool Model ----
# Apply SQL: supabase/card_pools.sql
# KRIPICARD_API_KEY=
# KRIPICARD_CREATE_CARD_URL=https://appapi.kripicard.com/api/external/cards/createcard
# KRIPICARD_API_URL=https://appapi.kripicard.com/v1/virtual-cards
# Real-time issue: POST /api/cards/issue (Next) / POST /api/user/cards/issue (Express)
# Apply form: POST /api/user/card/request — USDT wallet only, auto-issues via Kripicard
# KRIPICARD_DEFAULT_BIN=428803
# KRIPICARD_ALLOWED_BINS=428803,411111
# Pool fetch:     POST /api/admin/fetch-cards
# Pool assign:    POST /api/cards/purchase

# Deposit security
# DEPOSIT_LISTENER_SECRET=   # required in production for /api/deposit/verify
# USDT_MIN_CONFIRMATIONS=1
# USDT_DEPOSIT_DUPLICATE_WINDOW_SEC=90  # reject rapid same-amount / same-TxID spam (0 disables)
# BYPASS_USDT_TX_VERIFICATION=false  # never true in production

# ---- NOWPayments (crypto checkout IPN + USDT payouts) ----
# Dashboard → API keys / Store → IPN secret
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Webhook URL: https://YOUR_DOMAIN/api/nowpayments/webhook
# Mass payouts (Custody): dashboard email/password for JWT + optional 2FA
# NOWPAYMENTS_EMAIL=
# NOWPAYMENTS_PASSWORD=
# NOWPAYMENTS_PAYOUTS_ENABLED=true
# NOWPAYMENTS_REQUIRE_LIVE_PAYOUT=true
# USDT_AUTO_WITHDRAW_MAX_USDT=500
# NOWPAYMENTS_PAYOUT_2FA_SECRET=
# Payout IPN: https://YOUR_DOMAIN/api/nowpayments/payout-webhook
# Sync to Vercel: ./scripts/sync-nowpayments-env-to-vercel.sh --vercel

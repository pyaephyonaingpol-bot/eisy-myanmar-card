# Root env template for Vercel + local (placeholders only — never real secrets).
# Copy to `.env` or `backend/.env` (both are gitignored) and fill bare values.
# Canonical names below match what the Express backend reads today.
# Also see: backend/.env.example (fuller comments) and backend/docs/VERCEL.md

NODE_ENV=production
PUBLIC_BASE_URL=https://eisymyanmar.com

# ---- Auth / Admin (server-only) ----
# Generate: openssl rand -hex 32
AUTH_SECRET=
ADMIN_API_KEY=

# Field-level encryption for passport / NRC / KYC PII at rest (AES-256-GCM).
# Required in production. Generate: openssl rand -hex 32
SENSITIVE_DATA_ENCRYPTION_KEY=
# Alias: FIELD_ENCRYPTION_KEY=

# Stripe (webhook signature verification — fail closed without whsec_)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://eisymyanmar.com/api/webhook/stripe

# Optional rate-limit overrides (defaults shown):
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_KYC_MAX=20

# PIN token lifetime for withdrawals / sensitive actions (hours). Default 0.25 = 15 min.
# PIN_TOKEN_TTL_HOURS=0.25

# ---- CRITICAL INCIDENT KILL SWITCHES ----
# WITHDRAWALS_PAUSED=true
# AUTO_ONCHAIN_WITHDRAWALS=false
# MASTER_WALLET_TRANSFERS_PAUSED=true
# Per-user TRON HD wallet + Scan Pay (default OFF — use Kripicard)
# TRON_WALLET_ENABLED=false
# SCAN_PAY_ENABLED=false

# ---- Database (Turso / LibSQL on Vercel) ----
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# ---- Supabase (bare values only — no "KEY = value" text in the slot) ----
# Browser bridge uses URL + anon via GET /api/config/supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server dual-write / Storage / admin client (NEVER put this in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
# Aliases also accepted by code: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY / SUPABASE_SECRET_KEY

# ---- TRON master / HD wallets (server-only — never commit real keys) ----
# Hot wallet hex private key (64 hex chars, optional 0x prefix). Used for TRC20 withdrawals.
MASTER_PRIVATE_KEY=
# Optional explicit address (defaults to address derived from the private key)
MASTER_WALLET_ADDRESS=
# Alias also accepted: TRON_MASTER_WALLET=

# TronGrid API key (rate limits)
TRONGRID_API_KEY=
# Alias also accepted: TRON_API_KEY=

# TRON_FULL_HOST=https://api.trongrid.io
#
# Per-user HD deposit addresses (BIP44 m/44'/195'/account'/change/index):
# TRON_HD_ENABLED=true
# Prefer a dedicated deposit mnemonic (do NOT reuse the withdrawal hot-wallet key):
# TRON_HD_MNEMONIC="twelve or twenty four word bip39 mnemonic …"
# TRON_HD_SEED_HEX=
# Optional aliases also accepted: MASTER_WALLET_PRIVATE_KEY, TRON_MASTER_PRIVATE_KEY, TRON_PRO_API_KEY

# ---- Binance Pay ----
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MERCHANT_ID=

# ---- Kripicard Instant Cards (Non-KYC) ----
# CARD_API_KEY is an alias of KRIPICARD_API_KEY. CARD_BASE_URL is an alias of KRIPICARD_BASE_URL.
# KRIPICARD_API_KEY=
# CARD_API_KEY=
# KRIPICARD_BASE_URL=https://appapi.kripicard.com
# CARD_BASE_URL=https://appapi.kripicard.com
# KRIPICARD_CREATE_CARD_URL=https://appapi.kripicard.com/api/external/cards/createcard
# KRIPICARD_BINS_URL=https://appapi.kripicard.com/api/external/cards/bins
# KRIPICARD_DEFAULT_BIN=441357
# KRIPICARD_ALLOWED_BINS=
# KRIPICARD_TIMEOUT_MS=30000
# KRIPICARD_WEBHOOK_SECRET=
# KRIPICARD_WEBHOOK_URL=https://YOUR_DOMAIN/api/webhook/kripicard/deposits
# KRIPICARD_DEPOSITS_CREATE_URL=https://appapi.kripicard.com/api/external/deposits/create
# KRIPICARD_DEPOSITS_STATUS_URL=https://appapi.kripicard.com/api/external/deposits/status
# KRIPICARD_DEPOSITS_NETWORKS_URL=https://appapi.kripicard.com/api/external/deposits/networks


# ---- Deposit listener ----
# DEPOSIT_LISTENER_SECRET=

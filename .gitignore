# Dependencies
node_modules/
backend/data/*.db
backend/data/*.db-*
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/deposits/.gitkeep

# Vercel copies backend/public → root public/ during build; do not commit the copy
/public/

# Environment / secrets — never commit real values
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
!.env*.example
# Keep local overrides out of git even if named oddly
android/local.properties
**/local.properties
!**/local.properties.example
.env.local
.env.development
.env.staging
.env.production
.env.production.local
backend/.env
backend/.env.*
!backend/.env.example

# Flutter
user_app/.dart_tool/
user_app/build/
user_app/.flutter-plugins
user_app/.flutter-plugins-dependencies

# Capacitor mobile shell
mobile/node_modules/
mobile/www/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/.idea/
mobile/android/capacitor-cordova-android-plugins/

# Flutter / user_app local SDK paths
user_app/android/local.properties

# Android
deposit_listener/.gradle/
deposit_listener/app/build/
deposit_listener/local.properties
deposit_listener/.idea/
*.apk
!**/downloads/eisy-myanmar.apk

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

.vercel

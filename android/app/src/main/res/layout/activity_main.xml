<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eisy_bg"
    android:fitsSystemWindows="true">

    <!-- ScrollView wrapper so long WebView pages can scroll smoothly. -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls"
        android:isScrollContainer="true"
        android:clipToPadding="false">

        <!--
          ContentHeightWebView measures to full document height so the parent
          ScrollView becomes the vertical scroller (avoids clipped / stuck pages).
        -->
        <com.eisymyanmar.app.ContentHeightWebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/eisy_bg"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:overScrollMode="ifContentScrolls"
            android:isScrollContainer="true" />
    </ScrollView>
</FrameLayout>
